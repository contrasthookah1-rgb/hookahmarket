// Тонкий слой поверх Poster: Poster остаётся источником истины для товаров/
// остатков/клиентов/заказов, здесь — только то, чего в Poster никогда не было
// (распарсенные атрибуты, сессии, согласие на ПДн, слайды hero, лог заказов).
// См. docs/ARCHITECTURE.md и план в PROJECT_SPEC.md §2.4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon's pooled (pgbouncer) connection — right for the app at runtime on
  // Vercel's serverless functions.
  url       = env("DATABASE_URL")
  // Neon's direct (unpooled) connection — pgbouncer doesn't support the
  // prepared-statement/advisory-lock traffic `prisma migrate` needs. Matches
  // the var name `neon link`/`neon env pull` write automatically.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id       Int       @id @default(autoincrement())
  posterId Int       @unique
  label    String
  slug     String    @unique
  products Product[]
}

model Product {
  id                Int            @id @default(autoincrement())
  posterId          Int            @unique
  // ingredient_id from the connect account specifically — NOT a cross-branch
  // join key (each Poster account has its own local numbering, confirmed
  // against real data), kept only for reference/debugging. BranchStock and
  // BranchProductId below join by normalized product name instead.
  ingredientId      Int?
  categoryId        Int?
  category          Category?      @relation(fields: [categoryId], references: [id])
  categoryLabel     String
  name              String
  priceTenge        Int
  oldPriceTenge     Int?
  brand             String?
  flavor            String?
  strength          String?
  packaging         String?
  needsManualReview Boolean        @default(false)
  imageUrl          String?
  // Who set imageUrl last — "poster" (synced from the connect account's own
  // product photo) vs "manual" (uploaded through /admin/products or the hero
  // -slides admin, including this project's earlier hand/agent-sourced
  // photos, backfilled to "manual" once on migration). sync-catalog only
  // ever overwrites a "poster"/null row, never "manual" — otherwise a photo
  // an admin uploaded on the site would get silently replaced on the next
  // Poster sync.
  imageSource       String?
  active            Boolean        @default(true)
  // "Скрыть с сайта" checkbox in /admin/products. Separate from `active`
  // because sync-catalog overwrites `active` from Poster's `hidden` flag on
  // every run — a manual hide stored there would be undone nightly.
  hiddenManual      Boolean        @default(false)
  // Тип товара (SpecType) и значения его характеристик { "Материал": "Стекло" }.
  // Ключ — название поля из SpecType.fields на момент сохранения. Бренд/Вкус/
  // Крепость/Вес лежат в brand/flavor/strength/packaging, а не здесь — см.
  // lib/spec-types.ts. sync-catalog эти два поля не трогает.
  specTypeId        Int?
  specType          SpecType?      @relation(fields: [specTypeId], references: [id], onDelete: SetNull)
  // true — тип выбран руками в /admin/specs; sync-catalog автотип такому не меняет.
  specTypeManual    Boolean        @default(false)
  // Описание от админа (HTML, прошло lib/rich-text.ts). Poster текстовых описаний не даёт.
  descriptionManual String?
  images            ProductImage[]
  specs             Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  branchStock      BranchStock[]
  branchProductIds BranchProductId[]

  @@index([categoryLabel])
  @@index([brand])
  @@index([ingredientId])
}

// Ручные фото товара (первое = главное). Идут перед фото из Poster
// (Product.imageUrl), см. lib/catalog.ts. Sync-catalog их не трогает.
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

// Тип товара + список его характеристик. Редактируется в /admin/spec-types
// (начальный список — из миграции 20261019120000_add_spec_types).
model SpecType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  groupName String
  fields    String[]
  position  Int       @default(0)
  products  Product[]
}

// Каталог синкается из connect-аккаунта, но product_id (и ingredient_id) там
// НЕ совпадает с product_id того же товара в каждом филиальном аккаунте —
// подтверждено на реальных данных: франшиза-синк в Poster никогда не
// использовалась, у каждого филиала свои внутренние id. Единственное, что
// совпадает между аккаунтами — название товара. Эта таблица хранит
// per-branch product_id (нужен для incomingOrders.createIncomingOrder —
// заказ создаётся в аккаунте конкретного филиала, значит нужен ЕГО id, а
// не id из connect), полученный сопоставлением по названию при синке остатков.
model BranchProductId {
  id              Int     @id @default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch          String
  posterProductId Int

  @@unique([productId, branch])
}

// branch: "left" | "centre" | "alfarabi" — соответствует суффиксам
// POSTER_API_TOKEN_LEFT / _CENTRE / _ALFARABI в env.
model BranchStock {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([productId, branch])
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  linkUrl   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 4 фото в сетке 2×2 первого экрана главной (slot 0–3, слева направо, сверху
// вниз). Нет строки для слота — показывается стандартное фото категории, см.
// lib/hero-slides.ts.
model HeroTile {
  slot     Int    @id
  imageUrl String
  linkUrl  String
}

// Локальный лог заказов, созданных в Poster через incomingOrders.createIncomingOrder —
// нужен для истории уведомлений и как резерв, если сам Poster недоступен на записи.
model Order {
  id               Int      @id @default(autoincrement())
  branch           String
  posterOrderId    Int?
  customerName     String
  customerPhone    String
  items            Json
  deliveryType     String
  address          String?
  totalTenge       Int
  status           String   @default("new")
  whatsappNotified Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([customerPhone])
}

model Consent {
  id          Int      @id @default(autoincrement())
  phone       String
  textVersion String
  consentedAt DateTime @default(now())

  @@index([phone])
}

// Личный кабинет: вход по телефону, OTP отложен (см. lib/customer-auth.ts —
// OtpProvider сейчас DevNoOpOtpProvider). Токен — сессионная cookie.
model CustomerSession {
  id        Int      @id @default(autoincrement())
  phone     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

// Одноразовые коды входа (WhatsApp OTP, см. lib/otp.ts). Хранится HMAC кода, не сам код.
model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Страница /lounge целиком редактируется в /admin/lounge. Одна строка настроек
// (id = 1), точки и фото; LoungeImage.venueId = null — общая галерея «Атмосфера».
// Начальные данные — из миграции 20261020140000_add_lounge.
model LoungeSettings {
  id             Int     @id @default(1)
  enabled        Boolean @default(true)
  title          String
  subtitle       String
  // HTML из RichTextEditor, прошёл lib/rich-text.ts
  bodyHtml       String
  heroImageUrl   String?
  // пусто — берётся NEXT_PUBLIC_WHATSAPP_NUMBER
  whatsappNumber String?
}

model LoungeVenue {
  id        Int           @id @default(autoincrement())
  name      String
  address   String
  hours     String
  mapUrl    String
  sortOrder Int           @default(0)
  images    LoungeImage[]
}

model LoungeImage {
  id        Int          @id @default(autoincrement())
  venueId   Int?
  venue     LoungeVenue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int          @default(0)

  @@index([venueId, sortOrder])
}

// Блог (/blog). Пишется в /admin/articles; content — HTML из RichTextEditor,
// прошёл lib/rich-text.ts. Черновики (published = false) на сайте 404, админу
// видны для предпросмотра.
model Article {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  excerpt        String    @default("")
  content        String    @default("")
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}
